<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>IcoGenerator.Cli</RootNamespace>
    <!-- Optional pure-console host (true Console subsystem). Primary product is unified IcoGenerator.exe -->
    <AssemblyName>IcoGenerator.Cli</AssemblyName>
    <Description>Optional pure-console CLI host for IcoGenerator.</Description>
    <IsPackable>false</IsPackable>
    <ApplicationIcon>..\IcoGenerator.App\Assets\Icons\AppIcon.ico</ApplicationIcon>

    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\IcoGenerator.App\Assets\Icons\AppIcon.ico" Link="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IcoGenerator.Core\IcoGenerator.Core.csproj" />
  </ItemGroup>

</Project>
